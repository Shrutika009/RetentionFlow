    "# Single customer prediction\n",
    "\n",
    "def risk_tier(probability):\n",
    "\n",
    "    if probability >= 0.75:\n",
    "        return \"Critical\"\n",
    "\n",
    "    if probability >= 0.55:\n",
    "        return \"High\"\n",
    "\n",
    "    if probability >= 0.35:\n",
    "        return \"Medium\"\n",
    "\n",
    "    return \"Low\"\n",
    "\n",
    "\n",
    "def predict_single_customer(input_dict: dict) -> dict:\n",
    "\n",
    "    \"\"\"\n",
    "    Predict churn probability for a single customer.\n",
    "    \"\"\"\n",
    "\n",
    "    row = pd.DataFrame([input_dict])\n",
    "\n",
    "    # Normalize text columns\n",
    "    for column in row.select_dtypes(include=[\"object\"]).columns:\n",
    "\n",
    "        row[column] = (\n",
    "            row[column]\n",
    "            .astype(str)\n",
    "            .str.strip()\n",
    "            .str.lower()\n",
    "        )\n",
    "\n",
    "    # Feature engineering\n",
    "    row = add_compact_fields(\n",
    "        row,\n",
    "        reference=df_train\n",
    "    )\n",
    "\n",
    "    warnings_list = []\n",
    "\n",
    "    # Encode categorical features\n",
    "    for column in COMPACT_CATS:\n",
    "\n",
    "        if column not in row.columns:\n",
    "\n",
    "            row[column] = (\n",
    "                le_dict[column]\n",
    "                .classes_[0]\n",
    "            )\n",
    "\n",
    "        value = str(\n",
    "            row[column].iloc[0]\n",
    "        ).strip().lower()\n",
    "\n",
    "        known_classes = list(\n",
    "            le_dict[column].classes_\n",
    "        )\n",
    "\n",
    "        # Handle unseen categories\n",
    "        if value not in known_classes:\n",
    "\n",
    "            fallback = known_classes[0]\n",
    "\n",
    "            warnings_list.append(\n",
    "                f\"'{value}' unseen for '{column}' \"\n",
    "                f\"-> using fallback '{fallback}'\"\n",
    "            )\n",
    "\n",
    "            value = fallback\n",
    "\n",
    "        row[column] = le_dict[column].transform(\n",
    "            [value]\n",
    "        )[0]\n",
    "\n",
    "    # Fill numeric columns\n",
    "    for column in COMPACT_FEATURES:\n",
    "\n",
    "        if column not in COMPACT_CATS:\n",
    "\n",
    "            if column not in row.columns:\n",
    "\n",
    "                row[column] = train_medians.get(\n",
    "                    column,\n",
    "                    0\n",
    "                )\n",
    "\n",
    "            row[column] = pd.to_numeric(\n",
    "                row[column],\n",
    "                errors=\"coerce\"\n",
    "            )\n",
    "\n",
    "            row[column] = row[column].fillna(\n",
    "                train_medians.get(column, 0)\n",
    "            )\n",
    "\n",
    "    # Final feature matrix\n",
    "    X_row = row[COMPACT_FEATURES]\n",
    "\n",
    "    probability = float(\n",
    "        best_model.predict_proba(X_row)[0, 1]\n",
    "    )\n",
    "\n",
    "    prediction = int(\n",
    "        probability >= BEST_THRESHOLD\n",
    "    )\n",
    "\n",
    "    return {\n",
    "\n",
    "        \"churn_probability\": round(\n",
    "            probability,\n",
    "            4\n",
    "        ),\n",
    "\n",
    "        \"churn_prediction\": prediction,\n",
    "\n",
    "        \"risk_tier\": risk_tier(\n",
    "            probability\n",
    "        ),\n",
    "\n",
    "        \"action\": (\n",
    "            \"Relationship manager follow-up\"\n",
    "            if prediction\n",
    "            else \"Standard retention nurture\"\n",
    "        ),\n",
    "\n",
    "        \"warnings\": warnings_list,\n",
    "    }\n",
    "\n",
    "\n",
    "# Demo predictions\n",
    "\n",
    "print(\"=\" * 60)\n",
    "print(\"Single Customer Prediction Demo\")\n",
    "print(\"=\" * 60)\n",
    "\n",
