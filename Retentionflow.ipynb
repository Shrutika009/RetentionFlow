    "# RECOVERABLE REVENUE ESTIMATION\n",
    "\n",
    "# Business assumptions\n",
    "CLV_AT_RISK_PCT = 0.15\n",
    "\n",
    "INTERVENTION_SUCCESS = 0.30\n",
    "\n",
    "RETENTION_SPEND_PER_CUSTOMER = 500\n",
    "\n",
    "\n",
    "# Predicted churners\n",
    "predicted_churners = scoring_df[\n",
    "    scoring_df[\"churn_prediction\"] == 1\n",
    "].copy()\n",
    "\n",
    "\n",
    "# Ensure required column exists\n",
    "if \"customer_lifetime_value\" not in predicted_churners.columns:\n",
    "\n",
    "    predicted_churners[\"customer_lifetime_value\"] = 0\n",
    "\n",
    "\n",
    "# Revenue at risk\n",
    "predicted_churners[\"revenue_at_risk\"] = (\n",
    "\n",
    "    predicted_churners[\"customer_lifetime_value\"]\n",
    "\n",
    "    * CLV_AT_RISK_PCT\n",
    "\n",
    ").round(0)\n",
    "\n",
    "\n",
    "# Recoverable revenue\n",
    "predicted_churners[\"recoverable_revenue\"] = (\n",
    "\n",
    "    predicted_churners[\"revenue_at_risk\"]\n",
    "\n",
    "    * INTERVENTION_SUCCESS\n",
    "\n",
    ").round(0)\n",
    "\n",
    "\n",
    "# Net business benefit\n",
    "predicted_churners[\"net_benefit\"] = (\n",
    "\n",
    "    predicted_churners[\"recoverable_revenue\"]\n",
    "\n",
    "    - RETENTION_SPEND_PER_CUSTOMER\n",
    "\n",
    ").round(0)\n",
    "\n",
    "\n",
    "# Merge results into scoring dataframe\n",
    "revenue_columns = [\n",
    "\n",
    "    \"customer_id\",\n",
    "    \"revenue_at_risk\",\n",
    "    \"recoverable_revenue\",\n",
    "    \"net_benefit\",\n",
    "]\n",
    "\n",
    "scoring_df = scoring_df.merge(\n",
    "\n",
    "    predicted_churners[revenue_columns],\n",
    "\n",
    "    on=\"customer_id\",\n",
    "\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "\n",
    "# Fill missing values\n",
    "financial_columns = [\n",
    "\n",
    "    \"revenue_at_risk\",\n",
    "    \"recoverable_revenue\",\n",
    "    \"net_benefit\",\n",
    "]\n",
    "\n",
    "scoring_df[financial_columns] = (\n",
    "\n",
    "    scoring_df[financial_columns]\n",
    "\n",
    "    .fillna(0)\n",
    ")\n",
    "\n",
    "\n",
    "# Portfolio summary\n",
    "total_at_risk = (\n",
    "    predicted_churners[\"revenue_at_risk\"]\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "total_recoverable = (\n",
    "    predicted_churners[\"recoverable_revenue\"]\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "total_spend = (\n",
    "    len(predicted_churners)\n",
    "    * RETENTION_SPEND_PER_CUSTOMER\n",
    ")\n",
    "\n",
    "total_net = (\n",
    "    total_recoverable\n",
    "    - total_spend\n",
    ")\n",
    "\n",
    "roi = total_net / (total_spend + 1)\n",
    "\n",
    "\n",
    "print(\"=\" * 60)\n",
    "\n",
    "print(\"RECOVERABLE REVENUE ESTIMATION\")\n",
    "\n",
    "print(\"=\" * 60)\n",
    "\n",
    "print(\n",
    "    f\"\\nPredicted churners: \"\n",
    "    f\"{len(predicted_churners):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Total revenue at risk: \"\n",
    "    f\"₹{total_at_risk:,.0f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Recoverable revenue: \"\n",
    "    f\"₹{total_recoverable:,.0f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Retention spend: \"\n",
    "    f\"₹{total_spend:,.0f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Net benefit: \"\n",
    "    f\"₹{total_net:,.0f}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"ROI on retention: \"\n",
    "    f\"{roi:.1f}x\"\n",
    ")\n",
    "\n",
    "\n",
    "# Revenue by wealth tier\n",
    "if \"wealth_tier\" in scoring_df.columns:\n",
    "\n",
    "    predicted_churners[\"wealth_tier\"] = (\n",
    "\n",
    "        scoring_df.set_index(\"customer_id\")\n",
    "\n",
    "        .loc[\n",
    "            predicted_churners[\"customer_id\"],\n",
    "            \"wealth_tier\"\n",
    "        ]\n",
    "\n",
    "        .values\n",
    "    )\n",
    "\n",
    "    tier_revenue = (\n",
    "\n",
    "        predicted_churners\n",
    "\n",
    "        .groupby(\"wealth_tier\")[\n",
    "            [\n",
    "                \"revenue_at_risk\",\n",
    "                \"recoverable_revenue\"\n",
    "            ]\n",
    "        ]\n",
    "\n",
    "        .sum()\n",
    "\n",
    "        .sort_values(\n",
    "            \"revenue_at_risk\",\n",
    "            ascending=False\n",
    "        )\n",
    "    )\n",
    "\n",
    "    print(\"\\nRevenue by wealth tier:\\n\")\n",
    "\n",
    "    print(\n",
    "        tier_revenue.to_string()\n",
    "    )\n",
    "\n",
    "\n",
    "# Revenue analysis chart\n",
    "fig, ax = plt.subplots(\n",
    "    figsize=(10, 5)\n",
    ")\n",
    "\n",
    "categories = [\n",
    "\n",
    "    \"Revenue at Risk\",\n",
    "    \"Recoverable Revenue\",\n",
    "    \"Retention Spend\",\n",
    "    \"Net Benefit\",\n",
    "]\n",
    "\n",
    "values = [\n",
    "\n",
    "    total_at_risk / 1e6,\n",
    "\n",
    "    total_recoverable / 1e6,\n",
    "\n",
    "    -total_spend / 1e6,\n",
    "\n",
    "    total_net / 1e6,\n",
    "]\n",
    "\n",
    "colors = [\n",
    "\n",
    "    \"#E74C3C\",\n",
    "\n",
    "    \"#2196F3\",\n",
    "\n",
    "    \"#FF9800\",\n",
    "\n",
    "    \"#4CAF50\" if total_net > 0 else \"#E74C3C\",\n",
    "]\n",
    "\n",
    "bars = ax.bar(\n",
    "\n",
    "    categories,\n",
    "\n",
    "    values,\n",
    "\n",
    "    color=colors,\n",
    "\n",
    "    edgecolor=\"white\",\n",
    "\n",
    "    width=0.5\n",
    ")\n",
    "\n",
    "ax.set_title(\n",
    "    \"Recoverable Revenue Analysis (₹ Millions)\",\n",
    "    fontsize=13,\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "ax.set_ylabel(\n",
    "    \"₹ Millions\"\n",
    ")\n",
    "\n",
    "ax.axhline(\n",
    "    0,\n",
    "    color=\"black\",\n",
    "    linewidth=0.8\n",
    ")\n",
    "\n",
    "offset = max(abs(v) for v in values) * 0.03\n",
    "\n",
    "for bar, value in zip(bars, values):\n",
    "\n",
    "    ax.text(\n",
    "\n",
    "        bar.get_x() + bar.get_width() / 2,\n",
    "\n",
    "        value + offset,\n",
    "\n",
    "        f\"₹{value:.2f}M\",\n",
    "\n",
    "        ha=\"center\",\n",
    "\n",
    "        va=\"bottom\",\n",
    "\n",
    "        fontsize=10,\n",
    "\n",
    "        fontweight=\"bold\"\n",
    "    )\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "    CHART_DIR / \"revenue_recovery.png\",\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()"
   ]
