    "# SUBMISSION AND SCORING OUTPUTS\n",
    "\n",
    "def min_max(series):\n",
    "\n",
    "    series = pd.to_numeric(\n",
    "        series,\n",
    "        errors=\"coerce\"\n",
    "    ).fillna(0)\n",
    "\n",
    "    return (\n",
    "\n",
    "        (series - series.min())\n",
    "\n",
    "        /\n",
    "\n",
    "        (series.max() - series.min() + 1e-9)\n",
    "    )\n",
    "\n",
    "\n",
    "# Customer value score\n",
    "customer_value = (\n",
    "\n",
    "    min_max(df_train[\"customer_lifetime_value\"]) * 0.45\n",
    "\n",
    "    + min_max(df_train[\"annual_income\"]) * 0.25\n",
    "\n",
    "    + min_max(df_train[\"avg_monthly_balance\"]) * 0.20\n",
    "\n",
    "    + min_max(df_train[\"number_of_products\"]) * 0.10\n",
    "\n",
    ").round(4)\n",
    "\n",
    "\n",
    "# Training scoring dataframe\n",
    "scoring_df = df_train[[\"customer_id\"]].copy()\n",
    "\n",
    "scoring_df[\"churn_probability\"] = (\n",
    "    train_prob_full.round(4)\n",
    ")\n",
    "\n",
    "scoring_df[\"churn_prediction\"] = (\n",
    "    train_pred_full\n",
    ")\n",
    "\n",
    "scoring_df[\"actual_churn\"] = (\n",
    "    y.values\n",
    ")\n",
    "\n",
    "scoring_df[\"customer_value\"] = (\n",
    "    customer_value.values\n",
    ")\n",
    "\n",
    "scoring_df[\"risk_tier\"] = (\n",
    "\n",
    "    scoring_df[\"churn_probability\"]\n",
    "\n",
    "    .apply(risk_tier)\n",
    ")\n",
    "\n",
    "scoring_df[\"priority_score\"] = (\n",
    "\n",
    "    scoring_df[\"churn_probability\"]\n",
    "\n",
    "    * customer_value\n",
    "\n",
    ").round(4)\n",
    "\n",
    "scoring_df[\"revenue_at_risk\"] = (\n",
    "\n",
    "    scoring_df[\"churn_probability\"]\n",
    "\n",
    "    * df_train[\"customer_lifetime_value\"]\n",
    "\n",
    ").round(0)\n",
    "\n",
    "scoring_df[\"recoverable_revenue\"] = (\n",
    "\n",
    "    scoring_df[\"revenue_at_risk\"]\n",
    "\n",
    "    * 0.30\n",
    "\n",
    ").round(0)\n",
    "\n",
    "scoring_df[\"net_benefit\"] = (\n",
    "\n",
    "    scoring_df[\"recoverable_revenue\"]\n",
    "\n",
    "    - (\n",
    "        scoring_df[\"churn_prediction\"]\n",
    "        * FP_COST\n",
    "    )\n",
    "\n",
    ").round(0)\n",
    "\n",
    "scoring_df[\"wealth_tier\"] = pd.cut(\n",
    "\n",
    "    customer_value,\n",
    "\n",
    "    [-0.01, 0.25, 0.50, 0.75, 1.01],\n",
