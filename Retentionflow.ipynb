    "# CUSTOMER CLONING\n",
    "\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "\n",
    "print(\"=\" * 60)\n",
    "\n",
    "print(\"RETENTIONFLOW - CUSTOMER CLONING\")\n",
    "\n",
    "print(\"=\" * 60)\n",
    "\n",
    "\n",
    "# Clone feature set\n",
    "clone_features = [\n",
    "\n",
    "    feature for feature in COMPACT_FEATURES\n",
    "\n",
    "    if feature not in [\n",
    "        \"gender\",\n",
    "        \"occupation_type\",\n",
    "        \"city_tier\",\n",
    "        \"region\",\n",
    "    ]\n",
    "]\n",
    "\n",
    "\n",
    "# Prepare feature matrix\n",
    "X_clone = X.copy()\n",
    "\n",
    "for column in clone_features:\n",
    "\n",
    "    X_clone[column] = pd.to_numeric(\n",
    "        X_clone[column],\n",
    "        errors=\"coerce\"\n",
    "    ).fillna(0)\n",
    "\n",
    "\n",
    "# Scale features\n",
    "scaler_clone = MinMaxScaler()\n",
    "\n",
    "X_clone_scaled = scaler_clone.fit_transform(\n",
    "    X_clone[clone_features]\n",
    ")\n",
    "\n",
    "\n",
    "# Split churners vs retained\n",
    "churner_mask = (\n",
    "    y.values == 1\n",
    ")\n",
    "\n",
    "retained_mask = (\n",
    "    y.values == 0\n",
    ")\n",
    "\n",
    "X_churners = X_clone_scaled[\n",
    "    churner_mask\n",
    "]\n",
    "\n",
    "X_retained = X_clone_scaled[\n",
    "    retained_mask\n",
    "]\n",
    "\n",
    "\n",
    "# Customer IDs\n",
    "if \"customer_id\" in train_enc.columns:\n",
    "\n",
    "    churner_ids = (\n",
    "\n",
    "        train_enc[\"customer_id\"]\n",
    "\n",
    "        .values[churner_mask]\n",
    "    )\n",
    "\n",
    "    retained_ids = (\n",
    "\n",
    "        train_enc[\"customer_id\"]\n",
    "\n",
    "        .values[retained_mask]\n",
    "    )\n",
    "\n",
    "else:\n",
    "\n",
    "    churner_ids = np.arange(\n",
    "        churner_mask.sum()\n",
    "    )\n",
    "\n",
    "    retained_ids = np.arange(\n",
    "        retained_mask.sum()\n",
    "    )\n",
    "\n",
    "\n",
    "# Top high-risk churners\n",
    "top_churners = (\n",
    "\n",
    "    scoring_df[\n",
    "        scoring_df[\"churn_prediction\"] == 1\n",
    "    ]\n",
    "\n",
    "    .nlargest(\n",
    "        10,\n",
    "        \"churn_probability\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    \"\\nAnalysing top 10 high-risk churners...\\n\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"{'Customer ID':<15}\"\n",
    "    f\"{'Churn Prob':>12}  \"\n",
    "    f\"{'Top Gap Feature':<30}\"\n",
    "    f\"{'Customer':>12}\"\n",
    "    f\"{'Avg Retained':>15}\"\n",
    ")\n",
    "\n",
    "print(\"-\" * 90)\n",
    "\n",
    "\n",
    "clone_records = []\n",
    "\n",
    "for _, row in top_churners.iterrows():\n",
    "\n",
    "    customer_id = row[\"customer_id\"]\n",
    "\n",
    "    if \"customer_id\" not in train_enc.columns:\n",
    "        continue\n",
    "\n",
    "    idx_in_full = np.where(\n",
    "\n",
    "        train_enc[\"customer_id\"].values\n",
    "        == customer_id\n",
    "\n",
    "    )[0]\n",
    "\n",
    "    if len(idx_in_full) == 0:\n",
    "        continue\n",
    "\n",
    "\n",
    "    # Customer vector\n",
    "    customer_vector = (\n",
    "\n",
    "        X_clone_scaled[\n",
    "            idx_in_full[0]\n",
    "        ]\n",
    "\n",
    "        .reshape(1, -1)\n",
    "    )\n",
    "\n",
    "\n",
    "    # Similarity search\n",
    "    similarities = cosine_similarity(\n",
    "        customer_vector,\n",
    "        X_retained\n",
    "    )[0]\n",
    "\n",
    "    top5_idx = similarities.argsort()[\n",
    "        -5:\n",
    "    ][::-1]\n",
    "\n",
    "    top5_vectors = X_retained[\n",
    "        top5_idx\n",
    "    ]\n",
    "\n",
    "\n",
    "    # Average retained profile\n",
    "    avg_retained = (\n",
    "        top5_vectors.mean(axis=0)\n",
    "    )\n",
    "\n",
    "    customer_raw = customer_vector[0]\n",
    "\n",
    "\n",
    "    # Biggest improvement gap\n",
    "    gaps = (\n",
    "        avg_retained\n",
    "        - customer_raw\n",
    "    )\n",
    "\n",
    "    top_gap_index = gaps.argmax()\n",
    "\n",
    "    top_feature = clone_features[\n",
    "        top_gap_index\n",
    "    ]\n",
    "\n",
    "\n",
    "    # Convert back to original scale\n",
    "    customer_display = (\n",
    "\n",
    "        scaler_clone.inverse_transform(\n",
    "            customer_vector\n",
    "        )[0][top_gap_index]\n",
    "    )\n",
    "\n",
    "    retained_display = (\n",
    "\n",
    "        scaler_clone.inverse_transform(\n",
    "\n",
    "            avg_retained.reshape(1, -1)\n",
    "\n",
    "        )[0][top_gap_index]\n",
    "    )\n",
    "\n",
    "\n",
    "    print(\n",
    "\n",
    "        f\"{str(customer_id):<15}\"\n",
    "\n",
    "        f\"{row['churn_probability']:>11.1%}  \"\n",
    "\n",
    "        f\"{top_feature:<30}\"\n",
    "\n",
    "        f\"{customer_display:>12.1f}\"\n",
    "\n",
    "        f\"{retained_display:>15.1f}\"\n",
    "    )\n",
    "\n",
    "\n",
    "    clone_records.append({\n",
    "\n",
    "        \"customer_id\":\n",
    "            customer_id,\n",
    "\n",
    "        \"churn_probability\":\n",
    "            row[\"churn_probability\"],\n",
    "\n",
    "        \"top_gap_feature\":\n",
    "            top_feature,\n",
    "\n",
    "        \"churner_value\":\n",
    "            round(customer_display, 2),\n",
    "\n",
    "        \"avg_retained_value\":\n",
    "            round(retained_display, 2),\n",
    "\n",
    "        \"gap\":\n",
    "            round(\n",
    "                retained_display\n",
    "                - customer_display,\n",
    "                2\n",
    "            ),\n",
    "\n",
    "        \"similar_retained_ids\":\n",
    "            list(\n",
    "                retained_ids[top5_idx]\n",
    "            ),\n",
    "    })\n",
    "\n",
    "\n",
    "# Clone dataframe\n",
    "clone_df = pd.DataFrame(\n",
    "    clone_records\n",
    ")\n",
    "\n",
    "\n",
    "# Portfolio-level improvement analysis\n",
    "print(\n",
    "    \"\\n\\nMOST COMMON IMPROVEMENT OPPORTUNITIES\"\n",
    ")\n",
    "\n",
    "print(\"-\" * 50)\n",
    "\n",
    "\n",
    "sample_size = min(\n",
    "    200,\n",
    "    len(X_churners)\n",
    ")\n",
    "\n",
    "sample_indices = np.random.choice(\n",
    "\n",
    "    len(X_churners),\n",
    "\n",
    "    sample_size,\n",
    "\n",
    "    replace=False\n",
    ")\n",
    "\n",
    "\n",
    "all_gap_features = []\n",
    "\n",
    "for index in sample_indices:\n",
    "\n",
    "    customer_vector = (\n",
    "        X_churners[index]\n",
    "        .reshape(1, -1)\n",
    "    )\n",
    "\n",
    "    similarities = cosine_similarity(\n",
    "        customer_vector,\n",
    "        X_retained\n",
    "    )[0]\n",
    "\n",
    "    top_vectors = X_retained[\n",
    "        similarities.argsort()[-5:][::-1]\n",
    "    ]\n",
    "\n",
    "    avg_retained = (\n",
    "        top_vectors.mean(axis=0)\n",
    "    )\n",
    "\n",
    "    gap_index = (\n",
    "\n",
    "        avg_retained\n",
    "        - customer_vector[0]\n",
    "\n",
    "    ).argmax()\n",
    "\n",
    "    all_gap_features.append(\n",
    "        clone_features[gap_index]\n",
    "    )\n",
    "\n",
    "\n",
    "gap_counts = (\n",
    "\n",
    "    pd.Series(all_gap_features)\n",
    "\n",
    "    .value_counts()\n",
    "\n",
    "    .head(8)\n",
    ")\n",
    "\n",
    "\n",
    "for feature, count in gap_counts.items():\n",
    "\n",
    "    bar = \"█\" * int(\n",
    "\n",
    "        count\n",
    "\n",
    "        / gap_counts.max()\n",
    "\n",
    "        * 20\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"{feature:<30}\"\n",
    "        f\"{bar} \"\n",
    "        f\"{count}\"\n",
    "    )\n",
    "\n",
    "\n",
    "# Save output\n",
    "clone_df.to_csv(\n",
    "\n",
    "    OUTPUT_DIR / \"retentionflow_customer_cloning.csv\",\n",
    "\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"\\nCustomer cloning complete - \"\n",
    "    \"retentionflow_customer_cloning.csv\"\n",
    ")"
   ]
  },
