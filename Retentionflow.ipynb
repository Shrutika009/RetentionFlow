    "# ROI CALCULATOR PER CUSTOMER\n",
    "\n",
    "print(\"=\" * 60)\n",
    "\n",
    "print(\"RETENTIONFLOW - ROI CALCULATOR\")\n",
    "\n",
    "print(\"=\" * 60)\n",
    "\n",
    "\n",
    "# Predicted churners only\n",
    "roi_df = scoring_df[\n",
    "    scoring_df[\"churn_prediction\"] == 1\n",
    "].copy()\n",
    "\n",
    "\n",
    "# Ensure required columns exist\n",
    "required_columns = [\n",
    "\n",
    "    \"customer_lifetime_value\",\n",
    "    \"recoverable_revenue\",\n",
    "]\n",
    "\n",
    "for column in required_columns:\n",
    "\n",
    "    if column not in roi_df.columns:\n",
    "\n",
    "        roi_df[column] = 0\n",
    "\n",
    "\n",
    "# Intervention cost\n",
    "INTERVENTION_COST = FP_COST\n",
    "\n",
    "roi_df[\"intervention_cost\"] = (\n",
    "    INTERVENTION_COST\n",
    ")\n",
    "\n",
    "roi_df[\"expected_recovery\"] = (\n",
    "    roi_df[\"recoverable_revenue\"]\n",
    ")\n",
    "\n",
    "\n",
    "# ROI calculation\n",
    "roi_df[\"roi\"] = (\n",
    "\n",
    "    (\n",
    "        roi_df[\"expected_recovery\"]\n",
    "\n",
    "        - roi_df[\"intervention_cost\"]\n",
    "    )\n",
    "\n",
    "    /\n",
    "\n",
    "    roi_df[\"intervention_cost\"]\n",
    "\n",
    ").round(2)\n",
    "\n",
    "\n",
    "# ROI category\n",
    "roi_df[\"roi_category\"] = pd.cut(\n",
    "\n",
    "    roi_df[\"roi\"],\n",
    "\n",
    "    bins=[-999, 0, 10, 50, 999],\n",
    "\n",
    "    labels=[\n",
    "        \"Negative ROI\",\n",
    "        \"Low ROI (0-10x)\",\n",
    "        \"Medium ROI (10-50x)\",\n",
    "        \"High ROI (50x+)\",\n",
    "    ]\n",
    ")\n",
    "\n",
    "\n",
    "# Top ROI customers\n",
    "top_columns = [\n",
    "\n",
    "    \"customer_id\",\n",
    "    \"churn_probability\",\n",
    "    \"risk_tier\",\n",
    "    \"customer_lifetime_value\",\n",
    "    \"expected_recovery\",\n",
    "    \"intervention_cost\",\n",
    "    \"roi\",\n",
    "    \"roi_category\",\n",
    "]\n",
    "\n",
    "available_columns = [\n",
    "\n",
    "    column for column in top_columns\n",
    "\n",
    "    if column in roi_df.columns\n",
    "]\n",
    "\n",
    "top_roi = roi_df.nlargest(\n",
    "    20,\n",
    "    \"roi\"\n",
    ")[available_columns].reset_index(drop=True)\n",
    "\n",
    "top_roi.index += 1\n",
    "\n",
    "\n",
    "print(\"\\nTOP 20 CUSTOMERS BY RETENTION ROI\\n\")\n",
    "\n",
    "print(\n",
    "    top_roi.to_string()\n",
    ")\n",
    "\n",
    "\n",
    "# ROI summary\n",
    "print(\"\\n\\nROI CATEGORY BREAKDOWN\")\n",
    "\n",
    "print(\"-\" * 45)\n",
    "\n",
    "roi_summary = (\n",
    "\n",
    "    roi_df\n",
    "\n",
    "    .groupby(\n",
    "        \"roi_category\",\n",
    "        observed=True\n",
    "    )\n",
    "\n",
    "    .agg(\n",
    "\n",
    "        customers=(\n",
    "            \"customer_id\",\n",
    "            \"count\"\n",
    "        ),\n",
    "\n",
    "        total_recovery=(\n",
    "            \"expected_recovery\",\n",
    "            \"sum\"\n",
    "        ),\n",
    "\n",
    "        total_spend=(\n",
    "            \"intervention_cost\",\n",
    "            \"sum\"\n",
    "        ),\n",
    "\n",
    "        avg_roi=(\n",
    "            \"roi\",\n",
    "            \"mean\"\n",
    "        ),\n",
    "    )\n",
    "\n",
    "    .round(2)\n",
    ")\n",
    "\n",
    "print(\n",
    "    roi_summary.to_string()\n",
    ")\n",
    "\n",
    "\n",
    "# Portfolio totals\n",
    "total_recovery = (\n",
    "    roi_df[\"expected_recovery\"]\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "total_spend = (\n",
    "    roi_df[\"intervention_cost\"]\n",
    "    .sum()\n",
    ")\n",
    "\n",
    "overall_roi = (\n",
    "    (total_recovery - total_spend)\n",
    "    / (total_spend + 1e-9)\n",
    ")\n",
    "\n",
    "net_benefit = (\n",
    "    total_recovery\n",
    "    - total_spend\n",
    ")\n",
    "\n",
    "\n",
    "print(\n",
    "    f\"\\nOverall portfolio ROI: \"\n",
