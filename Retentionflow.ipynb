    "# RETENTION RECOMMENDATION ENGINE\n",
    "\n",
    "# Rule-based recommendation system\n",
    "\n",
    "def get_retention_recommendation(row):\n",
    "\n",
    "    \"\"\"\n",
    "    Generate personalized retention recommendations.\n",
    "    \"\"\"\n",
    "\n",
    "    actions = []\n",
    "\n",
    "    # High-value high-risk customers\n",
    "    if (\n",
    "\n",
    "        row.get(\"customer_value\", 0) > 0.6\n",
    "\n",
    "        and row.get(\"churn_probability\", 0) > 0.5\n",
    "    ):\n",
    "\n",
    "        actions.append({\n",
    "\n",
    "            \"action\":\n",
    "                \"Assign Dedicated Relationship Manager\",\n",
    "\n",
    "            \"reason\":\n",
    "                \"High-value customer at elevated churn risk\",\n",
    "\n",
    "            \"impact\":\n",
    "                \"High\",\n",
    "\n",
    "            \"channel\":\n",
    "                \"Phone / In-branch\",\n",
    "\n",
    "            \"priority\":\n",
    "                1,\n",
    "        })\n",
    "\n",
    "    # Competitor awareness\n",
    "    if row.get(\"competitor_aware_flag\", 0) == 1:\n",
    "\n",
    "        actions.append({\n",
    "\n",
    "            \"action\":\n",
    "                \"Competitive Rate Match + Exclusive Offer\",\n",
    "\n",
    "            \"reason\":\n",
    "                \"Customer is evaluating competitor banks\",\n",
    "\n",
    "            \"impact\":\n",
    "                \"High\",\n",
    "\n",
    "            \"channel\":\n",
    "                \"Phone / Email\",\n",
    "\n",
    "            \"priority\":\n",
    "                1,\n",
    "        })\n",
    "\n",
    "    # Declining balances\n",
    "    if (\n",
    "\n",
    "        row.get(\"zero_balance_flag\", 0) == 1\n",
    "\n",
    "        or row.get(\"balance_declining_flag\", 0) == 1\n",
    "    ):\n",
    "\n",
    "        actions.append({\n",
    "\n",
    "            \"action\":\n",
    "                \"Offer Fixed Deposit or High-Yield Savings Bonus\",\n",
    "\n",
    "            \"reason\":\n",
    "                \"Declining balances indicate disengagement\",\n",
    "\n",
    "            \"impact\":\n",
    "                \"Medium\",\n",
    "\n",
    "            \"channel\":\n",
    "                \"App Notification / SMS\",\n",
    "\n",
    "            \"priority\":\n",
    "                2,\n",
    "        })\n",
    "\n",
    "    # Single product customers\n",
    "    if row.get(\"single_product_flag\", 0) == 1:\n",
    "\n",
    "        actions.append({\n",
    "\n",
    "            \"action\":\n",
    "                \"Cross-Sell Credit Card or Investment Product\",\n",
    "\n",
    "            \"reason\":\n",
    "                \"Single-product customers have higher churn probability\",\n",
    "\n",
    "            \"impact\":\n",
    "                \"Medium\",\n",
    "\n",
    "            \"channel\":\n",
    "                \"Email / App\",\n",
    "\n",
    "            \"priority\":\n",
    "                2,\n",
    "        })\n",
    "\n",
    "    # Low digital activity\n",
    "    if row.get(\"low_digital_activity\", 0) == 1:\n",
    "\n",
    "        actions.append({\n",
    "\n",
    "            \"action\":\n",
    "                \"Digital Re-engagement Campaign\",\n",
    "\n",
    "            \"reason\":\n",
    "                \"Low digital engagement predicts disengagement\",\n",
    "\n",
    "            \"impact\":\n",
    "                \"Medium\",\n",
    "\n",
    "            \"channel\":\n",
    "                \"SMS / Push Notification\",\n",
    "\n",
    "            \"priority\":\n",
    "                3,\n",
    "        })\n",
    "\n",
    "    # Dormancy signals\n",
    "    if row.get(\"dormancy_risk_flag\", 0) == 1:\n",
    "\n",
    "        actions.append({\n",
    "\n",
    "            \"action\":\n",
    "                \"Dormancy Reactivation Offer\",\n",
    "\n",
    "            \"reason\":\n",
    "                \"Account inactivity signals possible churn\",\n",
    "\n",
    "            \"impact\":\n",
    "                \"High\",\n",
    "\n",
    "            \"channel\":\n",
    "                \"Phone / Branch\",\n",
    "\n",
    "            \"priority\":\n",
    "                1,\n",
    "        })\n",
    "\n",
    "    # Complaints and escalations\n",
    "    if (\n",
    "\n",
    "        row.get(\"high_complaint_flag\", 0) == 1\n",
    "\n",
    "        or row.get(\"escalation_count\", 0) >= 2\n",
    "    ):\n",
    "\n",
    "        actions.append({\n",
    "\n",
    "            \"action\":\n",
    "                \"Priority Complaint Resolution\",\n",
    "\n",
    "            \"reason\":\n",
    "                \"Repeated complaints strongly correlate with churn\",\n",
    "\n",
    "            \"impact\":\n",
    "                \"High\",\n",
    "\n",
    "            \"channel\":\n",
    "                \"Senior Support Team\",\n",
    "\n",
    "            \"priority\":\n",
    "                1,\n",
    "        })\n",
    "\n",
    "    # Financial stress\n",
    "    if row.get(\"financial_stress_flag\", 0) == 1:\n",
    "\n",
    "        actions.append({\n",
    "\n",
    "            \"action\":\n",
    "                \"Loan Restructuring or EMI Relief Offer\",\n",
    "\n",
    "            \"reason\":\n",
    "                \"Financial stress increases churn likelihood\",\n",
    "\n",
    "            \"impact\":\n",
    "                \"Medium\",\n",
    "\n",
    "            \"channel\":\n",
    "                \"Phone / Branch\",\n",
    "\n",
    "            \"priority\":\n",
    "                2,\n",
    "        })\n",
    "\n",
    "    # Low satisfaction\n",
    "    if row.get(\"low_satisfaction_flag\", 0) == 1:\n",
    "\n",
    "        actions.append({\n",
    "\n",
    "            \"action\":\n",
    "                \"Personalized Service Recovery Outreach\",\n",
    "\n",
    "            \"reason\":\n",
    "                \"Low satisfaction or NPS score detected\",\n",
    "\n",
    "            \"impact\":\n",
    "                \"High\",\n",
    "\n",
    "            \"channel\":\n",
    "                \"Phone / Email\",\n",
    "\n",
    "            \"priority\":\n",
    "                1,\n",
    "        })\n",
    "\n",
    "    # Premium customers\n",
    "    if (\n",
    "\n",
    "        row.get(\"wealth_tier\", \"\") in [\"Elite\", \"Premium\"]\n",
    "\n",
    "        and row.get(\"churn_probability\", 0) > 0.4\n",
    "    ):\n",
    "\n",
    "        actions.append({\n",
    "\n",
    "            \"action\":\n",
    "                \"Priority Banking Upgrade\",\n",
    "\n",
    "            \"reason\":\n",
    "                \"Premium customer not fully engaged\",\n",
    "\n",
    "            \"impact\":\n",
    "                \"High\",\n",
    "\n",
    "            \"channel\":\n",
    "                \"Dedicated Banker\",\n",
    "\n",
    "            \"priority\":\n",
    "                1,\n",
    "        })\n",
    "\n",
    "    # Default fallback\n",
    "    if not actions:\n",
    "\n",
    "        actions.append({\n",
    "\n",
    "            \"action\":\n",
    "                \"Standard Retention Email Campaign\",\n",
    "\n",
    "            \"reason\":\n",
    "                \"Low-risk customer\",\n",
    "\n",
    "            \"impact\":\n",
    "                \"Low\",\n",
    "\n",
    "            \"channel\":\n",
    "                \"Email\",\n",
    "\n",
    "            \"priority\":\n",
    "                4,\n",
    "        })\n",
    "\n",
    "    # Select highest-priority action\n",
    "    actions_sorted = sorted(\n",
    "        actions,\n",
    "        key=lambda item: item[\"priority\"]\n",
    "    )\n",
    "\n",
    "    top_action = actions_sorted[0]\n",
    "\n",
    "    return pd.Series({\n",
    "\n",
    "        \"recommended_action\":\n",
    "            top_action[\"action\"],\n",
    "\n",
    "        \"recommendation_reason\":\n",
    "            top_action[\"reason\"],\n",
    "\n",
    "        \"expected_impact\":\n",
    "            top_action[\"impact\"],\n",
    "\n",
    "        \"recommended_channel\":\n",
    "            top_action[\"channel\"],\n",
    "\n",
    "        \"num_risk_factors\":\n",
    "            len(actions_sorted),\n",
    "    })\n",
    "\n",
    "\n",
    "# Generate recommendations\n",
    "print(\"Generating retention recommendations\")\n",
    "\n",
    "recommendations = scoring_df.apply(\n",
    "    get_retention_recommendation,\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "scoring_df = pd.concat(\n",
    "    [scoring_df, recommendations],\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "\n",
    "# Summary\n",
    "print(\"\\n\" + \"=\" * 65)\n",
    "\n",
    "print(\"RECOMMENDATION ENGINE SUMMARY\")\n",
    "\n",
    "print(\"=\" * 65)\n",
    "\n",
    "churners = scoring_df[\n",
    "    scoring_df[\"churn_prediction\"] == 1\n",
    "]\n",
    "\n",
    "print(\"\\nTop recommended actions:\\n\")\n",
    "\n",
    "print(\n",
    "\n",
    "    churners[\"recommended_action\"]\n",
    "\n",
    "    .value_counts()\n",
    "\n",
    "    .head(10)\n",
    "\n",
    "    .to_string()\n",
    ")\n",
    "\n",
    "print(\"\\nExpected impact distribution:\\n\")\n",
    "\n",
    "print(\n",
    "\n",
    "    churners[\"expected_impact\"]\n",
    "\n",
    "    .value_counts()\n",
    "\n",
    "    .to_string()\n",
    ")\n",
    "\n",
    "\n",
    "# High-impact segment\n",
    "high_impact = churners[\n",
    "    churners[\"expected_impact\"] == \"High\"\n",
    "]\n",
    "\n",
    "print(\n",
    "    f\"\\nHigh-impact customers: \"\n",
    "    f\"{len(high_impact):,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Recoverable revenue from high-impact segment: \"\n",
    "    f\"₹{high_impact['recoverable_revenue'].sum():,.0f}\"\n",
    ")\n",
    "\n",
    "\n",
    "# Visualizations\n",
    "fig, axes = plt.subplots(\n",
    "    1,\n",
    "    2,\n",
    "    figsize=(16, 5)\n",
    ")\n",
    "\n",
    "fig.suptitle(\n",
    "    \"Retention Recommendation Engine\",\n",
    "    fontsize=13,\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "# Top actions\n",
    "(\n",
    "\n",
