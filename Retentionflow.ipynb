    "\n",
    "# Validation probabilities from best model\n",
    "raw_val_prob = y_prob_raw\n",
    "\n",
    "# Platt scaling\n",
    "platt_model = LogisticRegression()\n",
    "\n",
    "platt_model.fit(\n",
    "    logit(raw_val_prob).reshape(-1, 1),\n",
    "    y_val\n",
    ")\n",
    "\n",
    "# Isotonic calibration\n",
    "iso_model = IsotonicRegression(\n",
    "    out_of_bounds=\"clip\"\n",
    ")\n",
    "\n",
    "iso_model.fit(\n",
    "    raw_val_prob,\n",
    "    y_val\n",
    ")\n",
    "\n",
    "# Compare calibration methods\n",
    "platt_prob = platt_model.predict_proba(\n",
    "    logit(raw_val_prob).reshape(-1, 1)\n",
    ")[:, 1]\n",
    "\n",
    "iso_prob = iso_model.predict(raw_val_prob)\n",
    "\n",
    "platt_auc = average_precision_score(\n",
    "    y_val,\n",
    "    platt_prob\n",
    ")\n",
    "\n",
    "iso_auc = average_precision_score(\n",
    "    y_val,\n",
    "    iso_prob\n",
