    "# Final calibrated model wrapper\n",
    "\n",
    "class CalibratedRetentionModel:\n",
    "\n",
    "    \"\"\"\n",
    "    Wrapper around the trained model and calibration layer.\n",
    "    \"\"\"\n",
    "\n",
    "    def __init__(self, base, calibrator, method):\n",
    "\n",
    "        self.base = base\n",
    "        self.calibrator = calibrator\n",
    "        self.method = method\n",
    "\n",
    "    def predict_proba(self, X):\n",
    "\n",
    "        raw_probabilities = self.base.predict_proba(X)[:, 1]\n",
    "\n",
    "        # Platt scaling\n",
    "        if self.method == \"platt\":\n",
    "\n",
    "            calibrated = self.calibrator.predict_proba(\n",
    "                logit(raw_probabilities).reshape(-1, 1)\n",
    "            )[:, 1]\n",
    "\n",
    "        # Isotonic regression\n",
    "        else:\n",
    "\n",
    "            calibrated = self.calibrator.predict(\n",
    "                raw_probabilities\n",
    "            )\n",
    "\n",
    "        # Return probabilities in sklearn format\n",
    "        return np.column_stack([\n",
    "            1 - calibrated,\n",
    "            calibrated\n",
    "        ])\n",
    "\n",
    "    def get_feature_importance(self):\n",
    "\n",
    "        return self.base.get_feature_importance()\n",
    "\n",
    "\n",
    "# Build calibrated final model\n",
    "best_model = CalibratedRetentionModel(\n",
    "    base=base_model,\n",
    "    calibrator=calibrator,\n",
    "    method=calib_method\n",
    ")\n",
    "\n",
    "BEST_MODEL_NAME = (\n",
    "    f\"{BEST_MODEL_NAME}_{calib_method}_calibrated\"\n",
    ")\n",
    "\n",
    "# Full training predictions\n",
    "train_prob_full = best_model.predict_proba(X)[:, 1]\n",
    "\n",
    "train_pred_full = (\n",
    "    train_prob_full >= BEST_THRESHOLD\n",
    ").astype(int)\n",
    "\n",
    "# Test predictions\n",
    "test_prob_full = best_model.predict_proba(\n",
    "    X_submission\n",
    ")[:, 1]\n",
    "\n",
    "test_pred_full = (\n",
    "    test_prob_full >= BEST_THRESHOLD\n",
    ").astype(int)\n",
    "\n",
    "print(f\"Final model: {BEST_MODEL_NAME}\")\n",
    "\n",
    "print(f\"Decision threshold: {BEST_THRESHOLD:.2f}\")\n",
    "\n",
    "print(\"\\nTraining prediction summary\")\n",
