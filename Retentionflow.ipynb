    "# Data cleaning\n",
    "\n",
    "def clean_dataframe(df, is_train=True):\n",
    "\n",
    "    df = df.copy()\n",
    "\n",
    "    # Remove duplicate customer records\n",
    "    if \"customer_id\" in df.columns:\n",
    "\n",
    "        before = len(df)\n",
    "\n",
    "        df = df.drop_duplicates(subset=[\"customer_id\"])\n",
    "\n",
    "        print(f\"Dropped {before - len(df)} duplicate rows\")\n",
    "\n",
    "    # Separate categorical and numerical columns\n",
    "    cat_cols = df.select_dtypes(include=[\"object\"]).columns.tolist()\n",
    "\n",
    "    num_cols = df.select_dtypes(include=[np.number]).columns.tolist()\n",
    "\n",
    "    if is_train and TARGET in num_cols:\n",
    "        num_cols.remove(TARGET)\n",
    "\n",
    "    # Standardize categorical values\n",
    "    for column in cat_cols:\n",
    "\n",
    "        df[column] = (\n",
    "            df[column]\n",
    "            .astype(str)\n",
    "            .str.strip()\n",
    "            .str.lower()\n",
    "        )\n",
    "\n",
    "    # Convert numeric columns and handle missing values\n",
    "    for column in num_cols:\n",
    "\n",
    "        df[column] = pd.to_numeric(\n",
    "            df[column],\n",
    "            errors=\"coerce\"\n",
    "        )\n",
    "\n",
    "        if df[column].isnull().any():\n",
    "\n",
    "            df[column] = df[column].fillna(\n",
    "                df[column].median()\n",
    "            )\n",
    "\n",
    "    # Fill missing categorical values\n",
    "    for column in cat_cols:\n",
    "\n",
    "        if df[column].isnull().any():\n",
    "\n",
    "            df[column] = df[column].fillna(\n",
    "                df[column].mode()[0]\n",
    "            )\n",
    "\n",
    "    # Outlier capping using IQR\n",
    "    cap_cols = [\n",
    "        \"annual_income\",\n",
    "        \"avg_monthly_balance\",\n",
    "        \"current_balance\",\n",
    "        \"credit_card_limit\",\n",
    "        \"credit_card_spend\",\n",
    "        \"loan_outstanding_amount\",\n",
    "        \"monthly_transaction_value\",\n",
    "        \"customer_lifetime_value\",\n",
    "        \"total_trans_amt\",\n",
    "        \"avg_open_to_buy\",\n",
    "    ]\n",
    "\n",
    "    for column in [col for col in cap_cols if col in df.columns]:\n",
    "\n",
    "        q1 = df[column].quantile(0.25)\n",
    "        q3 = df[column].quantile(0.75)\n",
    "\n",
    "        iqr = q3 - q1\n",
    "\n",
    "        lower_bound = q1 - 1.5 * iqr\n",
    "        upper_bound = q3 + 1.5 * iqr\n",
    "\n",
    "        df[column] = df[column].clip(\n",
    "            lower_bound,\n",
    "            upper_bound\n",
    "        )\n",
    "\n",
    "    return df\n",
    "\n",
    "\n",
    "print(\"Cleaning training dataset\")\n",
    "df_train = clean_dataframe(df_train_raw, is_train=True)\n",
    "\n",
    "print(\"Cleaning test dataset\")\n",
    "df_test = clean_dataframe(df_test_raw, is_train=False)\n",
    "\n",
    "print(f\"Train shape: {df_train.shape}\")\n",
    "print(f\"Test shape : {df_test.shape}\")"
   ]
