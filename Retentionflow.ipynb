    "# PERFORMANCE CHARTS\n",
    "\n",
    "# Threshold optimisation inputs\n",
    "thresholds = np.arange(\n",
    "    0.05,\n",
    "    0.96,\n",
    "    0.01\n",
    ")\n",
    "\n",
    "biz_costs = []\n",
    "\n",
    "f1_scores = []\n",
    "\n",
    "\n",
    "# Validation fallback\n",
    "if \"y_val2\" not in globals():\n",
    "\n",
    "    y_val2 = y_val\n",
    "\n",
    "if \"y_prob_cal\" not in globals():\n",
    "\n",
    "    y_prob_cal = (\n",
    "        best_model.predict_proba(X_val)[:, 1]\n",
    "    )\n",
    "\n",
    "\n",
    "# Compute metrics across thresholds\n",
    "for threshold in thresholds:\n",
    "\n",
    "    predictions = (\n",
    "        y_prob_cal >= threshold\n",
    "    ).astype(int)\n",
    "\n",
    "    cm_temp = confusion_matrix(\n",
    "        y_val2,\n",
    "        predictions\n",
    "    )\n",
    "\n",
    "    fn = cm_temp[1, 0]\n",
    "\n",
    "    fp = cm_temp[0, 1]\n",
    "\n",
    "    business_cost = (\n",
    "        fn * FN_COST\n",
    "        + fp * FP_COST\n",
    "    )\n",
    "\n",
    "    biz_costs.append(\n",
    "        business_cost\n",
    "    )\n",
    "\n",
    "    f1_scores.append(\n",
    "\n",
    "        f1_score(\n",
    "            y_val2,\n",
    "            predictions,\n",
    "            zero_division=0\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "# Best threshold\n",
    "best_index = np.argmin(\n",
    "    biz_costs\n",
    ")\n",
    "\n",
    "BEST_THRESHOLD = round(\n",
    "    thresholds[best_index],\n",
    "    2\n",
    ")\n",
    "\n",
    "\n",
    "# Plot settings\n",
    "plt.rcParams.update({\n",
    "\n",
    "    \"text.color\": \"#0F172A\",\n",
    "\n",
    "    \"axes.labelcolor\": \"#0F172A\",\n",
    "\n",
    "    \"xtick.color\": \"#0F172A\",\n",
    "\n",
    "    \"ytick.color\": \"#0F172A\",\n",
    "})\n",
    "\n",
    "\n",
    "# Feature importance\n",
    "importance_values = (\n",
    "    base_model.get_feature_importance()\n",
    ")\n",
    "\n",
    "feature_importance_df = pd.DataFrame({\n",
    "\n",
    "    \"feature\":\n",
    "        COMPACT_FEATURES,\n",
    "\n",
    "    \"importance\":\n",
    "        importance_values,\n",
    "})\n",
    "\n",
    "feature_importance_df = (\n",
    "\n",
    "    feature_importance_df\n",
    "\n",
    "    .sort_values(\n",
    "        \"importance\"\n",
    "    )\n",
    ")\n",
    "\n",
    "\n",
    "fig, ax = plt.subplots(\n",
    "    figsize=(9, 6)\n",
    ")\n",
    "\n",
    "(\n",
    "\n",
    "    feature_importance_df\n",
    "\n",
    "    .tail(15)\n",
    "\n",
    "    .plot(\n",
    "\n",
    "        kind=\"barh\",\n",
    "\n",
    "        x=\"feature\",\n",
    "\n",
    "        y=\"importance\",\n",
    "\n",
    "        ax=ax,\n",
    "\n",
    "        legend=False,\n",
    "\n",
    "        color=\"#0EA5E9\"\n",
    "    )\n",
    ")\n",
    "\n",
    "ax.set_title(\n",
    "    \"Feature Importance (CatBoost)\",\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "ax.set_xlabel(\n",
    "    \"Importance Score\"\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "\n",
    "    CHART_DIR / \"feature_importance.png\",\n",
    "\n",
    "    dpi=160,\n",
    "\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# Threshold optimisation charts\n",
    "fig, axes = plt.subplots(\n",
    "    1,\n",
    "    2,\n",
    "    figsize=(12, 5)\n",
    ")\n",
    "\n",
    "\n",
    "# Business cost\n",
    "axes[0].plot(\n",
    "\n",
    "    thresholds,\n",
    "\n",
    "    np.array(biz_costs) / 1e6,\n",
    "\n",
    "    color=\"#E11D48\"\n",
    ")\n",
    "\n",
    "axes[0].axvline(\n",
    "\n",
    "    BEST_THRESHOLD,\n",
    "\n",
    "    color=\"#059669\",\n",
    "\n",
    "    linestyle=\"--\",\n",
    "\n",
    "    label=f\"Best = {BEST_THRESHOLD:.2f}\"\n",
    ")\n",
    "\n",
    "axes[0].set_title(\n",
    "    \"Business Cost vs Threshold\",\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "axes[0].set_xlabel(\n",
    "    \"Threshold\"\n",
    ")\n",
    "\n",
    "axes[0].set_ylabel(\n",
    "    \"₹ Millions\"\n",
    ")\n",
    "\n",
    "axes[0].legend()\n",
    "\n",
    "\n",
    "# F1 score\n",
    "axes[1].plot(\n",
    "\n",
    "    thresholds,\n",
    "\n",
    "    f1_scores,\n",
    "\n",
    "    color=\"#0EA5E9\"\n",
    ")\n",
    "\n",
    "axes[1].axvline(\n",
    "\n",
    "    BEST_THRESHOLD,\n",
    "\n",
    "    color=\"#059669\",\n",
    "\n",
    "    linestyle=\"--\"\n",
    ")\n",
    "\n",
    "axes[1].set_title(\n",
    "    \"F1 Score vs Threshold\",\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "axes[1].set_xlabel(\n",
    "    \"Threshold\"\n",
    ")\n",
    "\n",
    "axes[1].set_ylabel(\n",
    "    \"F1 Score\"\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "\n",
    "    CHART_DIR / \"threshold_optimisation.png\",\n",
    "\n",
    "    dpi=160,\n",
    "\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# Confusion matrix\n",
    "fig, ax = plt.subplots(\n",
    "    figsize=(5, 4)\n",
    ")\n",
    "\n",
    "cm = confusion_matrix(\n",
    "\n",
    "    y_val2,\n",
    "\n",
    "    (\n",
    "        y_prob_cal >= BEST_THRESHOLD\n",
    "    ).astype(int)\n",
    ")\n",
    "\n",
    "ax.imshow(\n",
    "    cm,\n",
    "    cmap=\"Blues\"\n",
    ")\n",
    "\n",
    "ax.set_title(\n",
    "    \"Validation Confusion Matrix\",\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "ax.set_xticks(\n",
    "    [0, 1],\n",
    "    [\"Retain\", \"Churn\"]\n",
    ")\n",
    "\n",
    "ax.set_yticks(\n",
    "    [0, 1],\n",
    "    [\"Retain\", \"Churn\"]\n",
    ")\n",
    "\n",
    "\n",
    "for (row, col), value in np.ndenumerate(cm):\n",
    "\n",
    "    ax.text(\n",
    "\n",
    "        col,\n",
    "\n",
    "        row,\n",
    "\n",
    "        value,\n",
    "\n",
    "        ha=\"center\",\n",
    "\n",
    "        va=\"center\",\n",
    "\n",
    "        fontweight=\"bold\",\n",
    "\n",
    "        color=(\n",
    "            \"white\"\n",
    "\n",
    "            if value > cm.max() / 2\n",
    "\n",
    "            else \"black\"\n",
    "        )\n",
    "    )\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "\n",
    "    CHART_DIR / \"confusion_matrix.png\",\n",
    "\n",
    "    dpi=160,\n",
    "\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# Risk tier distribution\n",
    "fig, ax = plt.subplots(\n",
    "    figsize=(8, 4)\n",
    ")\n",
    "\n",
    "(\n",
    "\n",
    "    scoring_df[\"risk_tier\"]\n",
    "\n",
    "    .value_counts()\n",
    "\n",
    "    .reindex([\n",
    "        \"Critical\",\n",
    "        \"High\",\n",
    "        \"Medium\",\n",
    "        \"Low\",\n",
    "    ])\n",
    "\n",
    "    .fillna(0)\n",
    "\n",
    "    .plot(\n",
    "\n",
    "        kind=\"bar\",\n",
    "\n",
    "        ax=ax,\n",
    "\n",
    "        color=[\n",
    "            \"#E11D48\",\n",
    "            \"#D97706\",\n",
    "            \"#FACC15\",\n",
    "            \"#059669\",\n",
    "        ]\n",
    "    )\n",
    ")\n",
    "\n",
    "ax.set_title(\n",
    "    \"Customer Count by Risk Tier\",\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "ax.tick_params(\n",
    "    axis=\"x\",\n",
    "    rotation=0\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "\n",
    "    CHART_DIR / \"risk_distribution.png\",\n",
    "\n",
    "    dpi=160,\n",
    "\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# Precision-recall curve\n",
    "fig, ax = plt.subplots(\n",
    "    figsize=(6, 4)\n",
    ")\n",
    "\n",
    "precision_array, recall_array, _ = (\n",
    "\n",
    "    precision_recall_curve(\n",
    "        y_val2,\n",
    "        y_prob_cal\n",
    "    )\n",
    ")\n",
    "\n",
    "ax.plot(\n",
    "\n",
    "    recall_array,\n",
    "\n",
    "    precision_array,\n",
    "\n",
    "    color=\"#0EA5E9\"\n",
    ")\n",
    "\n",
    "ax.set_title(\n",
    "    \"Precision-Recall Curve (Calibrated)\",\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "ax.set_xlabel(\n",
    "    \"Recall\"\n",
    ")\n",
    "\n",
    "ax.set_ylabel(\n",
    "    \"Precision\"\n",
    ")\n",
    "\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\n",
    "\n",
    "    CHART_DIR / \"pr_curve.png\",\n",
    "\n",
    "    dpi=160,\n",
    "\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "print(\n",
    "    f\"Best threshold selected: \"\n",
    "    f\"{BEST_THRESHOLD}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    \"All charts saved to:\",\n",
    "    CHART_DIR\n",
    ")"
   ]
  },
