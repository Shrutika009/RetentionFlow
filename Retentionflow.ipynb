    "# Feature engineering\n",
    "\n",
    "def add_compact_fields(frame, reference=None):\n",
    "\n",
    "    \"\"\"\n",
    "    Create engineered features used in the compact model.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    frame : DataFrame\n",
    "        Input dataset.\n",
    "\n",
    "    reference : DataFrame, optional\n",
    "        Training dataset used for stable median calculations\n",
    "        during inference.\n",
    "    \"\"\"\n",
    "\n",
    "    frame = frame.copy()\n",
    "\n",
    "    ref = frame if reference is None else reference\n",
    "\n",
    "    # Loan ownership flag\n",
    "    loan_flags = [\n",
    "        column for column in [\n",
    "            \"personal_loan_flag\",\n",
    "            \"home_loan_flag\",\n",
    "            \"auto_loan_flag\",\n",
    "        ]\n",
    "        if column in frame.columns\n",
    "    ]\n",
    "\n",
    "    if \"has_loan\" not in frame.columns:\n",
    "\n",
    "        if loan_flags:\n",
    "\n",
    "            frame[\"has_loan\"] = (\n",
    "                frame[loan_flags]\n",
    "                .apply(pd.to_numeric, errors=\"coerce\")\n",
    "                .fillna(0)\n",
    "                .sum(axis=1) > 0\n",
    "            ).astype(int)\n",
    "\n",
    "        else:\n",
    "            frame[\"has_loan\"] = 0\n",
    "\n",
    "    # Loan default history\n",
    "    if \"loan_default_history\" not in frame.columns:\n",
    "\n",
    "        delay = pd.to_numeric(\n",
    "            frame.get(\"emi_payment_delay_count\", 0),\n",
    "            errors=\"coerce\"\n",
    "        ).fillna(0)\n",
    "\n",
    "        risk = pd.to_numeric(\n",
    "            frame.get(\"loan_default_risk_score\", 0),\n",
    "            errors=\"coerce\"\n",
    "        ).fillna(0)\n",
    "\n",
    "        ref_risk = pd.to_numeric(\n",
    "            ref.get(\"loan_default_risk_score\", risk),\n",
    "            errors=\"coerce\"\n",
    "        ).fillna(0)\n",
    "\n",
    "        frame[\"loan_default_history\"] = (\n",
    "            (delay > 0) |\n",
    "            (risk > ref_risk.median())\n",
    "        ).astype(int)\n",
    "\n",
    "    # Combined digital activity\n",
    "    if \"digital_logins_derived\" not in frame.columns:\n",
    "\n",
    "        mobile_logins = pd.to_numeric(\n",
    "            frame.get(\"mobile_app_login_count\", 0),\n",
    "            errors=\"coerce\"\n",
    "        ).fillna(0)\n",
    "\n",
    "        website_logins = pd.to_numeric(\n",
    "            frame.get(\"website_login_count\", 0),\n",
    "            errors=\"coerce\"\n",
    "        ).fillna(0)\n",
    "\n",
    "        frame[\"digital_logins_derived\"] = (\n",
    "            mobile_logins + website_logins\n",
    "        )\n",
    "\n",
    "    # Ensure all compact model features exist\n",
    "    for column in COMPACT_FEATURES:\n",
    "\n",
    "        if column not in frame.columns:\n",
    "            frame[column] = 0\n",
    "\n",
    "    return frame\n",
    "\n",
    "\n",
    "def encode_compact(train_df, test_df):\n",
    "\n",
    "    \"\"\"\n",
    "    Apply feature engineering and encode categorical variables.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    train_enc : DataFrame\n",
    "    test_enc : DataFrame\n",
    "    le_dict : dict\n",
    "        Label encoders for categorical columns.\n",
    "    train_medians : dict\n",
    "        Median values used for numeric imputation.\n",
    "    \"\"\"\n",
    "\n",
    "    train_df = add_compact_fields(train_df)\n",
    "\n",
    "    test_df = add_compact_fields(\n",
    "        test_df,\n",
    "        reference=train_df\n",
    "    )\n",
    "\n",
    "    train_enc = train_df.copy()\n",
    "    test_enc = test_df.copy()\n",
    "\n",
    "    le_dict = {}\n",
    "\n",
    "    # Label encoding\n",
    "    for column in COMPACT_CATS:\n",
    "\n",
    "        encoder = LabelEncoder()\n",
    "\n",
    "        combined = (\n",
    "            pd.concat(\n",
    "                [train_enc[column], test_enc[column]],\n",
    "                ignore_index=True\n",
    "            )\n",
    "            .astype(str)\n",
    "            .str.lower()\n",
    "        )\n",
    "\n",
    "        encoder.fit(combined)\n",
    "\n",
    "        train_enc[column] = encoder.transform(\n",
    "            train_enc[column].astype(str).str.lower()\n",
    "        )\n",
    "\n",
    "        test_enc[column] = encoder.transform(\n",
    "            test_enc[column].astype(str).str.lower()\n",
    "        )\n",
    "\n",
    "        le_dict[column] = encoder\n",
    "\n",
    "    # Numeric preprocessing\n",
    "    train_medians = {}\n",
    "\n",
    "    for column in COMPACT_FEATURES:\n",
    "\n",
    "        if column not in COMPACT_CATS:\n",
    "\n",
    "            train_enc[column] = pd.to_numeric(\n",
    "                train_enc[column],\n",
    "                errors=\"coerce\"\n",
    "            )\n",
    "\n",
    "            median_value = (\n",
    "                train_enc[column].median()\n",
    "                if train_enc[column].notna().any()\n",
    "                else 0\n",
    "            )\n",
    "\n",
    "            train_enc[column] = train_enc[column].fillna(\n",
    "                median_value\n",
    "            )\n",
    "\n",
    "            test_enc[column] = (\n",
    "                pd.to_numeric(\n",
    "                    test_enc[column],\n",
    "                    errors=\"coerce\"\n",
    "                )\n",
    "                .fillna(median_value)\n",
    "            )\n",
    "\n",
    "            train_medians[column] = median_value\n",
    "\n",
    "    return train_enc, test_enc, le_dict, train_medians\n",
    "\n",
    "\n",
    "# Encode datasets\n",
    "train_enc, test_enc, le_dict, train_medians = encode_compact(\n",
    "    df_train,\n",
    "    df_test\n",
    ")\n",
    "\n",
    "# Model inputs\n",
    "X = train_enc[COMPACT_FEATURES]\n",
    "\n",
    "y = train_enc[TARGET].astype(int)\n",
    "\n",
    "X_submission = test_enc[COMPACT_FEATURES]\n",
    "\n",
    "print(f\"Feature matrix shape: {X.shape}\")\n",
    "print(f\"Churn rate: {y.mean() * 100:.1f}%\")\n",
    "\n",
    "print(\n",
    "    \"Engineered features: \"\n",
    "    \"has_loan, loan_default_history, digital_logins_derived\"\n",
    ")\n",
    "\n",
    "print(f\"Leakage columns removed: {LEAKAGE_COLS}\")"
   ]
  },
